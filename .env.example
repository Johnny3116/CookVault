# Postgres (must match docker-compose.yml's postgres service)
DATABASE_URL=postgresql+psycopg://cookvault:cookvault@postgres:5432/cookvault

# Optional single-password gate. Leave blank to disable auth entirely
# (reasonable for a Tailscale-only, single-user app). When set, the app shows
# a login page and stores an HMAC-signed session cookie -- not the password.
# ChefNexus sits behind the same gate: the frontend checks the cookie before it
# forwards a chat.
COOKVAULT_PASSWORD=

# Normally leave empty. The frontend proxies /api/* to the backend from its own
# origin, so the browser never makes a cross-origin request and CORS doesn't
# apply. Only set this (JSON array syntax) if you point a browser straight at
# the backend's port, e.g. ["https://nexusbody.tail344870.ts.net:8420"].
CORS_ORIGINS=[]

# The key that opens the /agent tool surface. Both the backend and the ChefNexus
# assistant read it from this file: the backend to check it, the assistant to
# present it. Leave blank and the surface is switched off -- and ChefNexus reports
# itself unavailable rather than coming up open because nobody set a variable.
# This is NOT the same credential as COOKVAULT_PASSWORD and does not open the
# same endpoints: through this key one can only read and propose drafts,
# never promote, write or delete.
#
# Minimum 32 characters; a shorter one refuses to boot rather than failing
# mysteriously later. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
AGENT_API_KEY=

# --- ChefNexus (cookvault-assistant) ---------------------------------------------
# The model. Ollama on the Docker host; from inside the container that host is
# host.docker.internal. On NexusBody Ollama listens on 11435, not 11434.
AI_PROVIDER=ollama
AI_BASE_URL=http://host.docker.internal:11435
AI_MODEL=qwen3:8b
# Qwen3 can reason before answering. Off by default: the GPU is shared with
# the voice stack, and tool selection has been fine without it.
AI_THINK=false
# Sent explicitly on every call. Ollama's own default truncates silently.
AI_NUM_CTX=8192
AI_TEMPERATURE=0.2
# Rounds of tool calls per turn before the model is made to answer.
MAX_TOOL_ROUNDS=6

# The outbound Agent Zero client is still not built, and these stay unused.
# See backend/app/agent_zero_client.py.
AGENT_ZERO_BASE_URL=https://nexusserver.tail344870.ts.net:50443
AGENT_ZERO_API_KEY=
