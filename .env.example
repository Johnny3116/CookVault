# Postgres (must match docker-compose.yml's postgres service)
DATABASE_URL=postgresql+psycopg://cookvault:cookvault@postgres:5432/cookvault

# Address the FRONTEND'S VIEWER (not the Docker host) uses to reach the backend.
# Baked into the frontend build (Next.js NEXT_PUBLIC_ constraint) -- rebuild the
# frontend image after changing this. Default is fine for local dev on the same
# machine running compose. On NexusBody, set this to the Tailscale address the
# backend is actually served on, e.g. https://nexusbody.tail344870.ts.net:8420
COOKVAULT_PUBLIC_API_URL=http://localhost:8420

# Optional single-password gate. Leave blank to disable auth entirely
# (reasonable for a Tailscale-only, single-user app).
COOKVAULT_PASSWORD=

# Phase 2 - not used yet, see backend/app/agent_zero_client.py
AGENT_ZERO_BASE_URL=https://nexusserver.tail344870.ts.net:50443
AGENT_ZERO_API_KEY=
