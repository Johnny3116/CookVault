[
  {
    "title": "Garlic Butter Steak Bites",
    "source_type": "manual",
    "cook_methods": [
      "stovetop"
    ],
    "prep_time": 10,
    "cook_time": 10,
    "servings": 2,
    "tags": [
      "american",
      "steak",
      "high-protein",
      "low-carb",
      "quick"
    ],
    "ingredients": [
      {
        "name": "sirloin steak",
        "quantity": 1,
        "unit": "lb",
        "category": "raw_ingredient"
      },
      {
        "name": "butter",
        "quantity": 3,
        "unit": "tbsp",
        "category": "raw_ingredient"
      },
      {
        "name": "garlic cloves",
        "quantity": 4,
        "unit": null,
        "category": "raw_ingredient"
      },
      {
        "name": "fresh parsley",
        "quantity": 1,
        "unit": "tbsp",
        "category": "raw_ingredient"
      },
      {
        "name": "salt",
        "quantity": 1,
        "unit": "tsp",
        "category": "spice_sauce"
      },
      {
        "name": "black pepper",
        "quantity": 0.5,
        "unit": "tsp",
        "category": "spice_sauce"
      },
      {
        "name": "red pepper flakes",
        "quantity": 0.25,
        "unit": "tsp",
        "category": "spice_sauce"
      },
      {
        "name": "vegetable oil",
        "quantity": 1,
        "unit": "tbsp",
        "category": "pantry_dry_good"
      }
    ],
    "steps": [
      {
        "order": 1,
        "instruction_text": "Cut the steak into 1-inch cubes, pat completely dry with paper towels, then season with the salt and pepper.",
        "notes": "Dry meat browns; wet meat steams."
      },
      {
        "order": 2,
        "instruction_text": "Heat the oil in a cast iron or heavy skillet until it just starts to smoke.",
        "temperature": "High heat",
        "duration": "2-3 min"
      },
      {
        "order": 3,
        "instruction_text": "Add the steak in a single layer without crowding (work in two batches if needed). Sear without moving, then flip and sear the other side.",
        "temperature": "High heat",
        "duration": "2-3 min, then 1-2 min",
        "notes": "Pull at about 130°F for medium-rare, 140°F for medium."
      },
      {
        "order": 4,
        "instruction_text": "Drop the heat, add the butter, minced garlic and red pepper flakes (optional), and toss the steak in the foaming butter until the garlic smells toasty.",
        "temperature": "Medium heat",
        "duration": "1 min",
        "notes": "Don't let the garlic go dark brown or it turns bitter."
      },
      {
        "order": 5,
        "instruction_text": "Toss with the chopped parsley and serve right away, spooning the pan butter over the top."
      }
    ],
    "alternates": [
      {
        "type": "cook_method",
        "original_value": "Stovetop sear",
        "alternate_value": "Air fryer at 400°F for 8-10 min, shaking halfway",
        "notes": "Melt the butter with the garlic separately and toss the cooked bites in it."
      },
      {
        "type": "ingredient_substitute",
        "original_value": "Sirloin steak",
        "alternate_value": "Ribeye or flank steak",
        "notes": "Ribeye is richer; cut flank against the grain before cubing."
      }
    ]
  },
  {
    "title": "Lemon Garlic Butter Salmon",
