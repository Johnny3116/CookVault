        "quantity": 1,
        "unit": "tbsp",
        "category": "pantry_dry_good"
      }
    ],
    "steps": [
      {
        "order": 1,
        "instruction_text": "Boil the penne in well-salted water until al dente, then drain.",
        "duration": "10-12 min"
      },
      {
        "order": 2,
        "instruction_text": "Meanwhile, cut the chicken into bite-size pieces and toss with 2 teaspoons of the Cajun seasoning."
      },
      {
        "order": 3,
        "instruction_text": "Heat the oil in a large skillet and cook the chicken until browned and cooked through. Move to a plate.",
        "temperature": "Medium-high heat",
        "duration": "6-7 min",
        "notes": "Done at 165°F."
      },
      {
        "order": 4,
        "instruction_text": "Add the butter and the sliced bell pepper to the same pan and cook until just soft, then add the minced garlic.",
        "temperature": "Medium heat",
        "duration": "3-4 min, then 30 sec"
      },
      {
        "order": 5,
        "instruction_text": "Pour in the broth and scrape up the browned bits, then add the cream and the remaining Cajun seasoning. Simmer until slightly thickened.",
        "temperature": "Medium-low heat",
        "duration": "3-4 min"
      },
      {
        "order": 6,
        "instruction_text": "Stir in the grated parmesan until melted, then add the pasta and chicken and toss to coat.",
        "notes": "Cajun blends vary a lot in salt; taste before adding any."
      }
    ],
    "alternates": [
      {
        "type": "ingredient_substitute",
        "original_value": "Chicken breast",
        "alternate_value": "1 lb peeled shrimp",
        "notes": "Sear 1-2 min per side; it cooks much faster than chicken."
      },
      {
        "type": "ingredient_substitute",
        "original_value": "Heavy cream",
        "alternate_value": "1 cup half-and-half plus 2 oz cream cheese",
        "notes": "Lighter but still won't split when it simmers."
      }
    ]
