      }
    ],
    "steps": [
      {
        "order": 1,
        "instruction_text": "Boil the spaghetti in well-salted water until al dente. Scoop out half a cup of the pasta water before draining.",
        "duration": "9-11 min"
      },
      {
        "order": 2,
        "instruction_text": "While it cooks, pat the shrimp dry and season with the salt."
      },
      {
        "order": 3,
        "instruction_text": "Melt 2 tablespoons of the butter in a large skillet and cook the shrimp until pink, then move them to a plate.",
        "temperature": "Medium-high heat",
        "duration": "1-2 min per side",
        "notes": "Pull them as soon as they curl into a C; an O means overcooked."
      },
      {
        "order": 4,
        "instruction_text": "Add the remaining butter, the thinly sliced garlic and the red pepper flakes and cook until the garlic is just golden.",
        "temperature": "Medium heat",
        "duration": "1 min"
      },
      {
        "order": 5,
        "instruction_text": "Add the spaghetti, lemon juice and zest and a splash of pasta water and toss until glossy, adding more water if it looks dry."
      },
      {
        "order": 6,
        "instruction_text": "Toss the shrimp back in with the grated parmesan and chopped parsley and serve."
      }
    ],
    "alternates": [
      {
        "type": "ingredient_substitute",
        "original_value": "Shrimp",
        "alternate_value": "1 lb chicken breast, diced",
