        "name": "butter",
        "quantity": 2,
        "unit": "tbsp",
        "category": "raw_ingredient"
      },
      {
        "name": "garlic cloves",
        "quantity": 2,
        "unit": null,
        "category": "raw_ingredient"
      },
      {
        "name": "lemon",
        "quantity": 1,
        "unit": null,
        "category": "raw_ingredient"
      },
      {
        "name": "salt",
        "quantity": 0.5,
        "unit": "tsp",
        "category": "spice_sauce"
      },
      {
        "name": "black pepper",
        "quantity": 0.25,
        "unit": "tsp",
        "category": "spice_sauce"
      },
      {
        "name": "paprika",
        "quantity": 0.5,
        "unit": "tsp",
        "category": "spice_sauce"
      },
      {
        "name": "olive oil",
        "quantity": 1,
        "unit": "tbsp",
        "category": "pantry_dry_good"
      }
    ],
    "steps": [
      {
        "order": 1,
        "instruction_text": "Heat the oven and line a baking sheet with foil or parchment. Brush it with the olive oil.",
        "temperature": "400°F"
      },
      {
        "order": 2,
        "instruction_text": "Pat the salmon (about 6 oz fillets) dry and set it skin-side down on the sheet. Season with the salt, pepper and paprika."
      },
      {
        "order": 3,
        "instruction_text": "Melt the butter and stir in the minced garlic, the lemon zest and half the lemon juice. Spoon it over the fillets."
      },
      {
        "order": 4,
        "instruction_text": "Bake until the salmon flakes easily with a fork.",
        "temperature": "400°F",
        "duration": "12-15 min",
        "notes": "Done at 145°F in the thickest part."
      },
      {
        "order": 5,
        "instruction_text": "Squeeze over the remaining lemon juice and spoon the pan butter on top before serving."
      }
    ],
    "alternates": [
      {
        "type": "cook_method",
        "original_value": "Oven at 400°F",
        "alternate_value": "Air fryer at 390°F for 8-10 min",
        "notes": "Add the butter mixture for the last 2 minutes so the garlic doesn't scorch."
      },
      {
        "type": "ingredient_substitute",
        "original_value": "Salmon",
        "alternate_value": "Cod or tilapia",
        "notes": "Thinner white fish needs only 10-12 min in the oven."
      }
    ]
  },
